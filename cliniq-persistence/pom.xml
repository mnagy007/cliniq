<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cliniq</groupId>
        <artifactId>cliniq</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cliniq-persistence</artifactId>
    <name>cliniq-persistence</name>
    <description>
        Persistence adapter: JPA entities, Spring Data repositories,
        and driven-port adapters. Depends on application layer ports.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-shared-kernel</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers for integration tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>