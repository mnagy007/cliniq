<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cliniq</groupId>
        <artifactId>cliniq</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cliniq-external-adapter</artifactId>
    <name>cliniq-external-adapter</name>
    <description>
        External adapter: OpenFDA medication lookup with Caffeine cache,
        Google Calendar sync, and Spring RestClient. Depends on application ports.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-domain</artifactId>
        </dependency>

        <!-- Spring Web (RestClient) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Caffeine cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Google Calendar API client -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.4.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-calendar</artifactId>
            <version>v3-rev20240419-2.0.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.5.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>