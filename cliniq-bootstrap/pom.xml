<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cliniq</groupId>
        <artifactId>cliniq</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cliniq-bootstrap</artifactId>
    <name>cliniq-bootstrap</name>
    <description>
        Bootstrap module: Spring Boot application entry point, wiring configuration,
        ArchUnit architectural rule tests, and Docker Compose setup.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-notification-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-external-adapter</artifactId>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- ArchUnit -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>