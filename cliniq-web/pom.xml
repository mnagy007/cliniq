<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cliniq</groupId>
        <artifactId>cliniq</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cliniq-web</artifactId>
    <name>cliniq-web</name>
    <description>
        Web adapter: REST controllers, DTOs, security filter, and global
        exception handler. Depends on application layer ports.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cliniq</groupId>
            <artifactId>cliniq-shared-kernel</artifactId>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- springdoc-openapi -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- Jakarta Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>