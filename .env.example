# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cliniq
SPRING_DATASOURCE_USERNAME=cliniq
SPRING_DATASOURCE_PASSWORD=cliniq

# Twilio Configuration (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid Configuration (for email notifications)
SENDGRID_FROM_EMAIL=noreply@cliniq.com

# OpenFDA Configuration
OPENFDA_BASE_URL=https://api.fda.gov

# Google Calendar Configuration
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret

# Encryption Configuration (32-character key for AES-256)
CLINIQ_ENCRYPTION_KEY=12345678901234567890123456789012

# Outbox Configuration
OUTBOX_POLL_DELAY_MS=5000
OUTBOX_BATCH_SIZE=50
